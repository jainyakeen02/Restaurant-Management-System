# DineOps Client Environment Variables
VITE_API_BASE_URL=http://localhost:5000/api

# EmailJS Service Configuration
# 1. Sign up at https://www.emailjs.com/
# 2. Add an Email Service (e.g. Gmail) -> get Service ID
# 3. Create an Email Template with variables {{to_name}}, {{to_email}}, {{reset_link}} -> get Template ID
# 4. In Account > API Keys -> get Public Key
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
